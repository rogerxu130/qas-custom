{
 "doctype": "DocType",
 "name": "Teaching Resource",
 "module": "QAS Custom",
 "autoname": "hash",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "title",
  "summary",
  "admin_note",
  "status",
  "import_id",
  "import_data"
 ],
 "fields": [
  {
   "fieldname": "title",
   "label": "Title",
   "fieldtype": "Data",
   "reqd": 1,
   "length": 200
  },
  {
   "fieldname": "summary",
   "label": "Summary",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "admin_note",
   "label": "Administrator Note",
   "fieldtype": "Small Text",
   "description": "Internal only. Never returned to teacher APIs."
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Draft\nPublished\nArchived\nDeleting\nDeleted",
   "default": "Draft",
   "reqd": 1
  },
  {
   "fieldname": "import_id",
   "label": "XML Course ID",
   "fieldtype": "Data",
   "length": 140,
   "unique": 1,
   "read_only": 1,
   "no_copy": 1,
   "description": "Unique source identity. Admin import API only."
  },
  {
   "fieldname": "import_data",
   "label": "XML Import Source",
   "fieldtype": "Long Text",
   "read_only": 1,
   "no_copy": 1,
   "description": "Internal source metadata and completion state. Never returned to teacher APIs."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
