{
 "doctype": "DocType",
 "name": "QAS Stripe Settings",
 "module": "QAS Custom",
 "engine": "InnoDB",
 "field_order": [
  "enabled",
  "pilot_notice",
  "mode",
  "test_secret_key",
  "test_webhook_secret",
  "live_secret_key",
  "live_webhook_secret",
  "signing_secret",
  "company",
  "clearing_account",
  "test_clearing_account",
  "mode_of_payment",
  "webhook_url",
  "test_notice"
 ],
 "fields": [
  {
   "fieldname": "enabled",
   "label": "Enable trial payments",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "pilot_notice",
   "fieldtype": "HTML",
   "options": "<p>Live payments are available for all eligible ordinary and replacement trial invoices. Test payments remain restricted to rogerxu130@gmail.com. Course, Workshop and store invoices are not eligible.</p>"
  },
  {
   "fieldname": "mode",
   "label": "Mode",
   "fieldtype": "Select",
   "options": "Test\nLive",
   "default": "Test",
   "reqd": 1
  },
  {
   "fieldname": "test_secret_key",
   "label": "Test Secret Key",
   "fieldtype": "Password"
  },
  {
   "fieldname": "test_webhook_secret",
   "label": "Test Webhook Signing Secret",
   "fieldtype": "Password"
  },
  {
   "fieldname": "live_secret_key",
   "label": "Live Secret Key",
   "fieldtype": "Password"
  },
  {
   "fieldname": "live_webhook_secret",
   "label": "Live Webhook Signing Secret",
   "fieldtype": "Password"
  },
  {
   "fieldname": "signing_secret",
   "label": "Payment Link Signing Secret",
   "fieldtype": "Password",
   "hidden": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company"
  },
  {
   "fieldname": "clearing_account",
   "label": "Stripe Clearing Account (AUD)",
   "fieldtype": "Link",
   "options": "Account"
  },
  {
   "fieldname": "mode_of_payment",
   "label": "Mode of Payment",
   "fieldtype": "Link",
   "options": "Mode of Payment"
  },
  {
   "fieldname": "webhook_url",
   "label": "Webhook URL",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "test_notice",
   "fieldtype": "HTML",
   "options": "Test payments update marked test invoices, create test payment entries, and send TEST receipts. No real money is collected. Cancel test records after acceptance testing. Fees and payouts require separate reconciliation."
  },
  {
   "fieldname": "test_clearing_account",
   "label": "Stripe Test Clearing Account (AUD)",
   "fieldtype": "Link",
   "options": "Account",
   "description": "Simulated payments update test invoices and post only to this separate ledger."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "track_changes": 1,
 "issingle": 1
}
